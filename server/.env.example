PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/attainment_db
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=8h
# Keep this value stable. It encrypts the Admin-visible copy of department passwords.
DEPARTMENT_PASSWORD_ENCRYPTION_KEY=change_this_to_another_long_random_secret

# External staff API
STAFF_API_BASE=https://apierp.bhc.edu.in/api/staff
STAFF_API_REFERER=http://10.240.151.162

# External departments/batches/course-allocation API (same ERP)
DEPARTMENTS_API_BASE=https://apierp.bhc.edu.in/api/admin/departments

# Gmail SMTP for sending OTP
GMAIL_USER=your_college_notification@gmail.com
GMAIL_APP_PASSWORD=your_16_char_gmail_app_password

# Admin bootstrap (used once, on first server start, to create the default admin if none exists)
ADMIN_ID=ADMIN001
ADMIN_PASSWORD=Admin@123

# College attainment API (server must be on the same LAN/VPN)
ATTAINMENT_API_BASE=http://192.168.18.89/hepta/api/attainment_data.php
ATTAINMENT_API_TIMEOUT=30000
